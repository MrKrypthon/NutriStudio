{
  "name": "nutri-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "dev:all": "concurrently -k -n API,WEB -c green,blue \"npm run api\" \"VITE_API_URL=http://localhost:3001 npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@prisma/client": "^6.19.0",
    "@fastify/cors": "latest",
    "dotenv": "^16.4.7",
    "pdfkit": "^0.17.2",
    "fastify": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "concurrently": "^9.1.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
