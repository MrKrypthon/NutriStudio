{
  "name": "nutri-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node tools/copy-ocr-assets.mjs",
    "predev": "node tools/copy-ocr-assets.mjs",
    "dev": "vite",
    "api": "node server/index.js",
    "dev:all": "concurrently -k -n API,WEB -c green,blue \"npm run api\" \"VITE_API_URL=http://localhost:3001/api/v1 npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "node prisma/migrate.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only --name",
    "db:seed": "prisma db seed",
    "admin:create": "node prisma/create-admin.js",
    "admin:reset-password": "node prisma/reset-admin-password.js",
    "catalog:import": "node prisma/import-catalog.js",
    "catalog:copy-recipes": "node prisma/tools/copy-catalog-recipes.js",
    "db:import-recetario": "node prisma/import-recetario.js",
    "recetario:extract": "node prisma/tools/extract-recetario.js && node prisma/tools/extract-recetario-images.js",
    "test": "vitest run",
    "db:link-smae": "node prisma/tools/link-smae.js --write",
    "db:recalculate-recipes": "node prisma/tools/recalculate-recipes.js --write",
    "recetario:link": "node prisma/tools/link-smae.js --analyze",
    "db:import-smae": "node prisma/import-smae.js",
    "db:import-smae-libro": "node prisma/import-smae-libro.js",
    "db:import-recetas": "node prisma/import-recetas.js",
    "db:import-recetas-nuevas": "node prisma/import-recetas-nuevas.js",
    "db:import-demo-practice": "node prisma/import-demo-practice.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:import-smae && npm run db:import-base && npm run db:import-recetas && npm run db:import-recetas-nuevas && npm run db:import-recetario && npm run db:link-smae && npm run db:import-demo-practice",
    "db:import-base": "node prisma/import-base-alimentos.js",
    "predev:all": "node prisma/sync-dev.js",
    "db:sync": "node prisma/sync-dev.js",
    "db:migrate-patient-sections": "node prisma/tools/migrate-patient-sections.js",
    "prebuild": "node tools/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "5.12.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "^9.1.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "vite": "8.2.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
