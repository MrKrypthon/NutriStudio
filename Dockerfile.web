# Frontend (React + Vite) servido por Nginx, que además hace de proxy de /api hacia la API (fase 113).
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY tools/copy-ocr-assets.mjs tools/
# postinstall copia a public/ocr el motor y los modelos del OCR (se sirven desde la propia app).
RUN npm ci --no-audit --no-fund
COPY . .
# Mismo dominio: el navegador llama a /api/v1 y Nginx lo pasa a la API.
ENV VITE_API_URL=/api/v1
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/nginx-health >/dev/null || exit 1
