DATABASE_URL="postgresql://nutri:nutri@localhost:5432/nutri_studio?schema=public"
VITE_API_URL="/api/v1"
DEFAULT_PRACTICE_ID="00000000-0000-0000-0000-000000000001"
PORT=3001
USDA_API_KEY="DEMO_KEY"
JWT_SECRET="change-me-to-a-long-random-string"

# Suscripción del SaaS con Stripe (fase 108). Empieza con las llaves de PRUEBA (sk_test_…); sin
# STRIPE_SECRET_KEY la sección «Suscripción» de Configuración sólo dice que no está activa.
# Los precios se crean en el panel de Stripe (Catálogo de productos) como recurrentes en MXN.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
# A dónde regresa Stripe después de pagar (la dirección del frontend).
APP_URL="http://localhost:5173"

# Cuentas (fase 109). Acceso con Google: crea un «ID de cliente de OAuth» de tipo «Aplicación web»
# en Google Cloud Console (APIs y servicios → Credenciales) y agrega tu dirección del frontend en
# «Orígenes de JavaScript autorizados» (en desarrollo, http://localhost:5173). Sin esto, el botón
# de Google no aparece y sólo se entra con identificador o correo.
GOOGLE_CLIENT_ID=""
# Práctica de donde sale el catálogo inicial (alimentos, libro SMAE y recetas) de cada cuenta
# nueva. Vacío = DEFAULT_PRACTICE_ID.
CATALOG_PRACTICE_ID=""

# Seguridad (fase 111). Con NODE_ENV=production la API no arranca si JWT_SECRET o ADMIN_JWT_SECRET
# faltan, miden menos de 32 caracteres, son iguales entre sí o son los valores de este archivo.
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NODE_ENV no va en este archivo (Vite también lee .env): se pone en el entorno del servidor.
# Secreto propio de los tokens del panel /admin. En desarrollo, vacío = usa JWT_SECRET.
ADMIN_JWT_SECRET=
# Orígenes que pueden llamar a la API desde el navegador, separados por comas. Vacío: en desarrollo
# cualquiera, en producción sólo el de APP_URL.
CORS_ORIGINS=
# Proxy de confianza para tomar la IP real del usuario (bitácora y límite de intentos). Vacío = nadie.
# Detrás de Nginx en el mismo equipo: loopback. En Docker: la red del proxy (p. ej. 172.16.0.0/12).
# No pongas «true» si la API también se puede alcanzar sin pasar por el proxy.
TRUST_PROXY=
