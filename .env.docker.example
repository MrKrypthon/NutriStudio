# Variables de docker-compose.app.yml (fase 113). Copia este archivo a .env.docker (no se versiona)
# y llena los valores. Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# PostgreSQL del contenedor `db` (la base se crea vacía la primera vez).
POSTGRES_USER=milpa
POSTGRES_PASSWORD=
POSTGRES_DB=milpa
# La misma contraseña de arriba, codificada para URL si tiene símbolos.
DATABASE_URL=postgresql://milpa:CAMBIA_ESTA_CONTRASENA@db:5432/milpa?schema=public

NODE_ENV=production
TZ=UTC
# Secretos de los tokens: al menos 32 caracteres, distintos entre sí.
JWT_SECRET=
ADMIN_JWT_SECRET=
# Dirección pública del frontend (Stripe regresa aquí; CORS sólo la acepta a ella).
# Local: http://localhost:8080 · En el VPS: https://TU-DOMINIO
APP_URL=http://localhost:8080
# Sólo en el VPS (docker-compose.prod.yml, ver DESPLIEGUE.md): dominio público y correo para Let's
# Encrypt. Con MILPA_DOMAIN, deploy/backup.sh y restore.sh usan también el archivo de producción.
MILPA_DOMAIN=
MILPA_ACME_EMAIL=
# Nginx es el único que llega a la API, por la red interna de Docker (rangos privados).
TRUST_PROXY=uniquelocal

# Opcionales
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
USDA_API_KEY=
CATALOG_PRACTICE_ID=00000000-0000-0000-0000-000000000001
